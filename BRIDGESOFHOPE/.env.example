# Copy to .env in BRIDGESOFHOPE/ before running the app.
# Do not commit .env.

# Required: Supabase values (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Expo mobile (CapstoneMobile): use the SAME URL and anon key. Either copy into
# CapstoneMobile/.env as EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY
# (see CapstoneMobile/.env.example), or from CapstoneMobile run: npm run sync-env

# Staff login email: lastname + first initial @ role-based host — nurse.<root> or staff.<root>
# (e.g. decenad@nurse.bridgesofhope.ph). Root domain (no leading @):
# VITE_STAFF_EMAIL_ROOT_DOMAIN=bridgesofhope.ph
# Legacy: VITE_STAFF_INSTITUTIONAL_EMAIL_DOMAIN=staff.bridgesofhope.ph still works; root is taken as last two labels (bridgesofhope.ph).
# Each new staff account gets its own randomly generated initial password (see src/lib/staffInitialPassword.js) — no env var needed.

# Account creation runs entirely through Supabase Auth's Admin API (Edge Function
# create-staff-auth-user) — no third-party service involved.
#    npx supabase link --project-ref YOUR_REF
#    npm run deploy:create-staff-auth-user

# Staff welcome email is sent over plain SMTP (Edge Function send-staff-welcome-email, using the
# `denomailer` library — NOT Resend or any other email API). bridgesofhope.ph has no real mailbox
# (it's only used for the auto-generated staff login usernames), so this sends via a real Gmail
# account instead. Requires 2-Step Verification enabled on that Google account, then an App
# Password: myaccount.google.com/apppasswords -> generate one for "Mail":
#    npx supabase secrets set SMTP_HOST=smtp.gmail.com
#    npx supabase secrets set SMTP_PORT=465
#    npx supabase secrets set SMTP_USERNAME=youraddress@gmail.com
#    npx supabase secrets set SMTP_PASSWORD=your-16-char-app-password
#    npx supabase secrets set SMTP_FROM="Bridges of Hope <youraddress@gmail.com>"
#    Optional: HTTPS URL shown at top of welcome email (hosted logo on your site or CDN).
#    npx supabase secrets set EMAIL_BRAND_LOGO_URL=https://your-domain.com/logo.png
#    npm run deploy:staff-welcome-email

# Google sign-in: Supabase Dashboard -> Authentication -> URL Configuration -> Redirect URLs
# must include this app's callback, e.g. http://localhost:5173/auth/callback and your production /auth/callback

# Optional — hospital referral scan (Groq API; browser exposes the key — use a backend proxy in production).
# VITE_GROQ_API_KEY=gsk_...
# VITE_GROQ_REFERRAL_SCAN_MODEL=llama-3.2-11b-vision-preview
# VITE_GROQ_REFERRAL_TEXT_MODEL=llama-3.3-70b-versatile
