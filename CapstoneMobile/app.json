{
  "expo": {
    "name": "Kalinga",
    "slug": "CapstoneMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kalingalogo.png",
    "scheme": "capstonemobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bridgesofhope.capstonemobile"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/kalingalogo.png",
        "backgroundImage": "./assets/images/kalingalogo.png",
        "monochromeImage": "./assets/images/kalingalogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bridgesofhope.capstonemobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kalingalogo.png"
    },
    "plugins": [
      "./plugins/withCmakeVersion",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/kalingalogo.png",
          "color": "#F54E25",
          "sounds": [
            "./assets/sounds/ding.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/ping.wav",
            "./assets/sounds/pop.wav",
            "./assets/sounds/soft.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/kalingalogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "f0f3a293-32f1-4281-a4bf-966c73f044f2"
      }
    },
    "owner": "dwight00900"
  }
}
